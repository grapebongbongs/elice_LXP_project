# 복사해서 .env 로 쓰기 (.env 는 git 제외). OPENAI_BASE_URL / OPENAI_MODEL 은 런박스에 미리 설정돼 있음.
OPENAI_API_KEY=발급받은_키
EMBEDDING_API_KEY=발급받은_키
# EMBEDDING_BASE_URL / EMBEDDING_MODEL은 런박스에 미리 설정돼 있다.
# 기본 1536차원 하이브리드 검색. 512 비교는 별도 후보에서만 이 값을 바꾼다.
TUTOR_EMBEDDING_DIMENSIONS=1536
# submission.json 의 token 과 같은 값. 영문·숫자·기호만, LLM 키와 다른 값
SERVER_TOKEN=change-me-team-token
# LLM_MOCK=1   # 크레딧 없이 형식/부하 테스트
